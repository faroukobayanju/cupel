# --- SERV (required) -------------------------------------------------------
# console.openserv.ai -> API keys
SERV_API_KEY=

# Probed live: -serv-kronos IS available. Set true to use it for mandate compilation.
KRONOS_OK=

# --- Benchmark raw arm (required for the raw-vs-SERV comparison) -----------
# The raw arm MUST be the same model as the SERV arm, or the benchmark measures
# model quality instead of SERV's contribution. Gemini is in SERV's catalog AND
# has a free direct tier, so use Gemini on both sides. Get a key at
# aistudio.google.com/apikey (free tier, no card).
GEMINI_API_KEY=

# Only needed if you deliberately want an OpenAI-model raw arm instead.
# Leave blank otherwise. Not required.
OPENAI_API_KEY=

# --- Chain -----------------------------------------------------------------
# MUST be https://, not wss:// — viem's http() transport cannot use a websocket URL.
# https://base-sepolia.drpc.org works and returns chainId 0x14a34 (84532).
BASE_SEPOLIA_RPC=https://base-sepolia.drpc.org

# The EVM address whose vault positions we read. Your burner's public address.
HOLDER_ADDRESS=

# Private key of a THROWAWAY EVM wallet holding only testnet funds.
# You put this here yourself. Never paste it into chat. Never reuse a real wallet.
# Needs Base Sepolia ETH for gas.
BURNER_PRIVATE_KEY=

# --- Vaults ----------------------------------------------------------------
# NOTE: probed live on 2026-09-24 — IXS has NO testnet deployment. Their API
# exposes 4 vaults, all the same product (IX High Yield Bond, USDC, ~3.07% ttm),
# on Avalanche mainnet and BSC mainnet only. Zero on Base Sepolia.
# These four slots are the simulated portfolio until that is resolved.
VAULT_MMF=
VAULT_CORP=
VAULT_CREDIT=
VAULT_BTC=

# Real IXS mainnet vaults, for READ-ONLY live data. No funds are ever at risk
# from a read. Populate only if the decision is to read production contracts.
IXS_BSC_VAULT=0xc975a3EeF2e49F8eDdEf585340C43f15300fCB82
IXS_AVAX_VAULT=0xaD01573b459805E3954398796203d830B57A8bD9

# --- Runtime ---------------------------------------------------------------
# true = no chain reads at all. Leave true until the vault question is settled.
SIMULATED_CHAIN=true

# Campaign worker pool width. Default 20 when unset.
CUPEL_CONCURRENCY=
